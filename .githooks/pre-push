#!/bin/sh
# Локальный гейт перед git push: гоняем полную проверку (типы + smoke-тесты +
# интеграционные тесты движков + сборка) на ЭТОЙ машине, до того как код вообще
# уйдёт в GitHub/Amvera.
#
# Почему гейт именно здесь, а не только в CI: Amvera подключена к GitHub
# вебхуком и катит main при каждом push сама, не дожидаясь GitHub Actions.
# Красный CI деплой НЕ останавливает — он приходит уже после того, как прод
# обновился. Значит, единственная проверка перед продом — эта.
#
# Интеграционным тестам нужен запущенный локальный Postgres (они работают в
# отдельной базе …_test и создают её сами). Если он не поднят — проверка
# честно упадёт с объяснением, а не пропустит непроверенный код.
# Ставится автоматически через `npm install` (см. postinstall в package.json,
# core.hooksPath), поэтому работает и после свежего клонирования репозитория.
#
# Пропустить осознанно (не рекомендуется): git push --no-verify

echo "[pre-push] npm run check (тайпчек + smoke + интеграционные тесты + сборка)..."

if npm run check; then
  echo "[pre-push] OK — пушим."
  exit 0
else
  echo ""
  echo "[pre-push] ПРОВАЛЕНО — push заблокирован."
  echo "[pre-push] Почини ошибку выше, либо (осознанно) обойди: git push --no-verify"
  exit 1
fi
