# === Smailee — пример переменных окружения ===
# Скопируй в .env и заполни реальными значениями:  cp .env.example .env

# Claude / Anthropic (генерация писем, диалог, квалификация) — пока в UI "Скоро"
ANTHROPIC_API_KEY=

# DeepSeek (основной LLM-провайдер)
DEEPSEEK_API_KEY=

# База данных (Postgres)
DATABASE_URL=

# Битрикс24 — вебхук ДЛЯ ФОРМЫ ЛЕНДИНГА (заявки на демо самого Smailee).
# Не путать с интеграцией CRM для клиентов продукта — та per-user и хранится
# в БД (User.bitrixWebhookEnc), задаётся через настройки в приложении.
LANDING_BITRIX_WEBHOOK_URL=

# Системная почта Smailee: приглашения сотрудников и восстановление пароля.
# Например, почтовый ящик info@smailee.ru.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=465
SYSTEM_SMTP_SECURE=true
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_MAIL_FROM="Smailee <no-reply@smailee.ru>"
SYSTEM_INFO_MAIL_FROM="Smailee <info@smailee.ru>"

# Секрет для подписи сессий (в проде — длинная случайная строка)
JWT_SECRET=

# Публичный URL приложения (для пикселей открытий и служебных ссылок)
# Локально: http://localhost:3000 ; на проде: https://<app>.amvera.io
APP_URL=http://localhost:3000

# Общий Telegram-бот для уведомлений о лидах. Создайте через @BotFather и
# вставьте токен — username и webhook Smailee настроит автоматически.
TELEGRAM_BOT_TOKEN=

# Отдельный закрытый бот для заявок Smailee и будущих системных уведомлений.
# Создайте нового бота в @BotFather. После запуска приложения доступ выдаётся
# только одноразовой ссылкой из /app/admin; chat id вручную задавать не нужно.
TELEGRAM_ADMIN_BOT_TOKEN=

# Ключ шифрования доступов к почтовым ящикам (SMTP/IMAP-пароли, см. src/lib/crypto.ts).
# 32 байта в hex (64 символа). Сгенерировать: openssl rand -hex 32
MAILBOX_ENC_KEY=

# Email администратора: аккаунт с этим email получает роль ADMIN при регистрации
ADMIN_EMAIL=

# Секрет вебхука платёжного шлюза (ЮMoney и т.п.)
PAYMENT_WEBHOOK_SECRET=

# ── Прогрев (§5.6) ──
# ТЕСТОВЫЙ РЕЖИМ: длительность одной ступени ramp в мс. Боевой дефолт — сутки
# (86400000). Для сквозного теста поставь 60000 (1 мин = 1 «день») → ящик
# доходит до warm за ~14 минут и кампанию можно запустить в тот же день.
# На боевом окружении переменную НЕ задавать (оставить пустой/удалить).
# WARMUP_DAY_MS=60000
