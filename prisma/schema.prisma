// Smailee — схема БД
// Postgres (dev: локальный smailee_dev; prod: Amvera Postgres через DATABASE_URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyFieldType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  STRING_LIST
  JSON
}

enum ProspectingRunStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ProspectingCandidateStatus {
  PENDING
  PROCESSING
  ACCEPTED
  REJECTED
  FAILED
}

enum EmailVerificationState {
  UNVERIFIED
  PENDING
  VALID
  ACCEPT_ALL
  UNKNOWN
  INVALID
  DISPOSABLE
  WEBMAIL
  BLOCKED
  CLAIMED
}

enum ContactImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ContactImportItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Canonical company independent of any individual data supplier.
model Company {
  id                          String    @id @default(cuid())
  countryCode                 String    @default("RU")
  inn                         String?
  ogrn                        String?
  legalName                   String?
  displayName                 String?
  /// Customer-facing name confirmed from the company's own website.
  communicationName           String?
  communicationNameConfidence Float?
  communicationNameSource     String?
  communicationNameEvidence   String?
  communicationNameUpdatedAt  DateTime?
  website                     String?
  domain                      String?
  status                      String?
  /// Lossless merged projection of every field seen for this company.
  data                        Json      @default("{}")
  firstSeenAt                 DateTime  @default(now())
  lastSeenAt                  DateTime  @default(now())
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @default(now()) @updatedAt

  sourceRecords          CompanySourceRecord[]
  fieldValues            CompanyFieldValue[]
  siteIntelligence       CompanySiteIntelligence?
  prospectContacts       CompanyProspectContact[]
  prospectingCandidates  ProspectingRunCompany[]
  prospectingRunContacts ProspectingRunContact[]
  campaignContacts       Contact[]                @relation("ContactSourceCompany")

  @@unique([countryCode, inn])
  @@unique([countryCode, ogrn])
  @@index([domain])
  @@index([displayName])
}

/// Public or provider-sourced company contact with field-level provenance.
model CompanyProspectContact {
  id                 String                 @id @default(cuid())
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email              String
  kind               String                 @default("generic")
  name               String?
  role               String?
  source             String
  sourceUrl          String?
  confidence         Float                  @default(0.5)
  verificationStatus String?
  verificationState  EmailVerificationState @default(UNVERIFIED)
  verificationScore  Int?
  verificationSource String?
  verifiedAt         DateTime?
  observedAt         DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt

  sources               CompanyProspectContactSource[]
  selectedForCandidates ProspectingRunCompany[]        @relation("SelectedProspectingContact")
  prospectingRuns       ProspectingRunContact[]

  @@unique([companyId, email])
  @@index([email])
  @@index([source, observedAt])
}

/// One observation of a canonical email. Multiple suppliers never overwrite each other's evidence.
model CompanyProspectContactSource {
  id         String                 @id @default(cuid())
  contactId  String
  contact    CompanyProspectContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider   String
  sourceKey  String
  sourceUrl  String?
  rawData    Json?
  observedAt DateTime               @default(now())
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @default(now()) @updatedAt

  @@unique([contactId, sourceKey])
  @@index([provider, observedAt])
}

/// Resumable, tenant-scoped job. Query, limits and actual usage are immutable audit inputs/outputs.
model ProspectingRun {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User                 @relation("ProspectingRunCreator", fields: [createdById], references: [id], onDelete: Cascade)
  status            ProspectingRunStatus @default(DRAFT)
  query             Json
  targetCompanies   Int                  @default(250)
  targetContacts    Int                  @default(500)
  maxCandidates     Int                  @default(500)
  allowAcceptAll    Boolean              @default(true)
  minAcceptAllScore Int                  @default(0)
  budgets           Json                 @default("{}")
  usage             Json                 @default("{}")
  selectedCount     Int                  @default(0)
  processedCount    Int                  @default(0)
  acceptedCount     Int                  @default(0)
  rejectedCount     Int                  @default(0)
  cursor            Int                  @default(0)
  error             String?
  completionReason  String?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt

  candidates ProspectingRunCompany[]
  contacts   ProspectingRunContact[]
  issues     ProspectingRunIssue[]

  @@index([organizationId, status])
  @@index([status, createdAt])
}

/// A provider/stage failure is kept separately from the public run state so
/// support can diagnose partial runs without exposing raw supplier responses.
model ProspectingRunIssue {
  id         String         @id @default(cuid())
  runId      String
  run        ProspectingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId  String?
  stage      String
  provider   String?
  code       String
  message    String
  retryable  Boolean        @default(false)
  details    Json?
  resolvedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([runId, createdAt])
  @@index([runId, resolvedAt])
  @@index([code])
}

/// Exact contacts collected for a run. A company can contribute any number of contacts.
model ProspectingRunContact {
  id        String                 @id @default(cuid())
  runId     String
  run       ProspectingRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId String
  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String
  contact   CompanyProspectContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime               @default(now())

  @@unique([runId, contactId])
  @@index([runId, companyId])
}

/// Per-company checkpoint. A worker can resume after every candidate without paying twice.
model ProspectingRunCompany {
  id                   String                     @id @default(cuid())
  runId                String
  run                  ProspectingRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId            String
  company              Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  position             Int
  status               ProspectingCandidateStatus @default(PENDING)
  selectedContactId    String?
  selectedContact      CompanyProspectContact?    @relation("SelectedProspectingContact", fields: [selectedContactId], references: [id], onDelete: SetNull)
  rejectionReason      String?
  error                String?
  personalizationHooks Json                       @default("[]")
  usage                Json                       @default("{}")
  attempts             Int                        @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @default(now()) @updatedAt

  @@unique([runId, companyId])
  @@unique([runId, position])
  @@index([runId, status])
  @@index([companyId])
}

/// Cached, evidence-backed snapshot of a prospect company's public website.
/// Shared by campaigns because Company is canonical across data suppliers.
model CompanySiteIntelligence {
  id           String    @id @default(cuid())
  companyId    String    @unique
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rootUrl      String
  provider     String    @default("firecrawl")
  status       String    @default("READY")
  pages        Json      @default("[]")
  intelligence Json      @default("{}")
  contentHash  String?
  creditsUsed  Int       @default(0)
  analyzedAt   DateTime?
  expiresAt    DateTime?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([status, expiresAt])
}

/// Global demand-driven cache for paid provider operations. Entries are reused across tenants.
model ExternalDataOperation {
  id           String   @id @default(cuid())
  operationKey String   @unique
  provider     String
  operation    String
  input        Json
  result       Json
  status       String   @default("SUCCESS")
  requests     Int      @default(0)
  credits      Float    @default(0)
  executedAt   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([provider, operation, expiresAt])
}

/// Metadata only. API secrets remain in encrypted settings/env, never here.
model CompanyDataSource {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  priority     Int      @default(0)
  active       Boolean  @default(true)
  capabilities Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  records     CompanySourceRecord[]
  fieldValues CompanyFieldValue[]
}

/// Latest lossless provider payload and its normalized representation.
model CompanySourceRecord {
  id              String            @id @default(cuid())
  sourceId        String
  source          CompanyDataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId      String
  rawData         Json
  normalizedData  Json
  checksum        String
  sourceUpdatedAt DateTime?
  observedAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  fieldValues CompanyFieldValue[]

  @@unique([sourceId, externalId])
  @@index([companyId, observedAt])
  @@index([checksum])
}

/// Global canonical field dictionary. Unknown provider fields are namespaced.
model CompanyFieldDefinition {
  id         String           @id @default(cuid())
  key        String           @unique
  label      String?
  type       CompanyFieldType
  filterable Boolean          @default(true)
  facetable  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  values CompanyFieldValue[]
}

/// Typed searchable projection of an arbitrary field. Exactly one value column is populated.
model CompanyFieldValue {
  id             String                 @id @default(cuid())
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fieldId        String
  field          CompanyFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  sourceId       String
  source         CompanyDataSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceRecordId String?
  sourceRecord   CompanySourceRecord?   @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  sourcePriority Int                    @default(0)
  stringValue    String?
  numberValue    Decimal?               @db.Decimal(30, 6)
  booleanValue   Boolean?
  dateValue      DateTime?
  stringList     String[]               @default([])
  jsonValue      Json?
  rawValue       Json
  observedAt     DateTime               @default(now())
  updatedAt      DateTime               @default(now()) @updatedAt

  @@unique([companyId, fieldId])
  @@index([fieldId, stringValue])
  @@index([fieldId, numberValue])
  @@index([fieldId, booleanValue])
  @@index([fieldId, dateValue])
  @@index([sourceId, observedAt])
}

// ── Пользователь (владелец аккаунта, self-serve) ──
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  // Legacy-поля оставлены на время безопасного перехода старых локальных
  // аккаунтов. Вход и создание новых пользователей на них не опираются.
  login              String?   @unique
  emailPending       Boolean   @default(false)
  passwordHash       String
  passwordEnabled    Boolean   @default(true)
  emailVerifiedAt    DateTime?
  // Временный пароль выдан администратором: до смены пароля доступ к ЛК закрыт.
  mustChangePassword Boolean   @default(false)
  name               String?
  companyName        String?
  createdAt          DateTime  @default(now())

  // роль: клиент или админ сервиса
  role                    UserRole                 @default(CLIENT)
  // Роль внутри кабинета организации. UserRole выше — служебная роль Smailee,
  // она не даёт прав на данные другой компании.
  organizationRole        OrganizationRole         @default(ORG_ADMIN)
  organizationPermissions OrganizationPermission[] @default([])
  organizationId          String?
  organization            Organization?            @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)
  ownedOrganization       Organization?            @relation("OrganizationOwner")
  // тарифный план и срок его действия
  // TRIAL сохранён как техническое состояние «доступ приостановлен», а не
  // TRIAL — бессрочный пробный тариф. planExpiresAt используется платными тарифами.
  plan                    Plan                     @default(TRIAL)
  // Начало текущего периода квот. Оплата будущего периода может пройти
  // раньше этой даты и не должна преждевременно обнулять использование.
  planPeriodStartedAt     DateTime?
  planExpiresAt           DateTime?
  // Источник текущего доступа нужен, чтобы банковская оплата не складывалась
  // с выданным вручную периодом как с уже оплаченным.
  planSource              PlanSource               @default(TRIAL)
  // Уже оплаченный будущий период. Может быть апгрейдом, даунгрейдом или
  // продлением и применяется только в выбранную дату активации.
  scheduledPlan           Plan?
  scheduledPlanAt         DateTime?
  scheduledPlanExpiresAt  DateTime?
  // Историческая отметка первого запуска демо и явный текущий режим демо.
  demoUsedAt              DateTime?
  isDemo                  Boolean                  @default(false)
  // Принятие правил использования каждым физическим пользователем.
  // Версия обязательна: существенная новая редакция может запросить повторный акцепт.
  acceptedTermsAt         DateTime?
  acceptedTermsVersion    String?

  // Денормализованное зеркало опубликованного OrganizationProfile для
  // совместимости со старым кодом. Не редактируется как отдельный источник.
  websiteUrl     String?
  offer          String? // ценностное предложение / оффер
  targetAudience String? // портрет клиента, кого ищем

  // Режим модерации ИИ-ответов (ТЗ §5.5): пока true — ответ ИИ на входящее
  // письмо сохраняется черновиком (ReplyMessage.status=DRAFT) и ждёт одобрения
  // оператора, а не уходит сразу. Default true — безопасное поведение на пилотах.
  aiModerationEnabled    Boolean @default(true)
  // Глобальный автопинг для диалогов в состоянии «Мороз». Владелец задаёт
  // задержку до первого пинга, интервал повторов и максимальное число попыток.
  autoPingEnabled        Boolean @default(false)
  autoPingStartAfterDays Int     @default(7)
  autoPingIntervalDays   Int     @default(7)
  autoPingMaxAttempts    Int     @default(3)

  // Онбординг-визард (UX TO BE, R2): когда пользователь закрыл визард
  // крестиком (или прошёл до конца). null = визард ещё показывается с /app.
  setupClosedAt DateTime?

  // Брендинг писем (R3): один фирменный цвет (кнопки/акценты HTML-шаблонов)
  // и URL логотипа для шапки письма. null = дефолтный вид шаблонов.
  brandColor     String?
  brandLogoUrl   String?
  // Расширение брендинга: шрифт и подпись клиента. Пусто — письмо рендерится
  // НЕЙТРАЛЬНО (системный шрифт, серые акценты), но никогда в цветах/логотипе
  // Smailee: письмо идёт от имени клиента, наш бренд в нём неуместен.
  brandFont      String?
  brandSignature String? // подпись в конце письма: имя, должность, контакты

  // Два независимых слоя настройки ответов ИИ (§5.5). dialogStylePrompt —
  // редактируемый вывод из реальных диалогов; funnelPrompt — обязательные
  // ручные инструкции организации, которые имеют приоритет при конфликте.
  dialogStylePrompt String?
  funnelPrompt      String?

  // ── Интеграция с Битрикс24 (CRM) ──
  // Вебхук ИНДИВИДУАЛЕН для каждого клиента: это ссылка вида
  // https://<портал>.bitrix24.ru/rest/<user>/<token>/ — по сути пароль от его
  // CRM. Общего вебхука в env быть не должно: он отправлял бы лиды ВСЕХ
  // клиентов в один чужой портал. Хранится зашифрованным (AES-256-GCM, тот же
  // MAILBOX_ENC_KEY, см. src/lib/crypto.ts) — как SMTP/IMAP-пароли (§8.2).
  bitrixWebhookEnc    String?
  // Что считать поводом передать лида в CRM. Значения — ключи из
  // src/lib/crm/handoffTriggers.ts. saveCrmSettings не даёт сохранить пустой
  // список (и пустую customHandoffPrompt одновременно) — без хотя бы одного
  // сигнала ИИ не может понять, когда лид готов, и держит линию бесконечно.
  // Дефолт для новых аккаунтов — все встроенные триггеры сразу включены.
  crmHandoffTriggers  String[] @default(["call_request", "meeting_request", "ready_to_start", "decision_maker"])
  // Свой сценарий передачи — свободный текст вместо (или вместе с) чекбоксов
  // выше. Например: «клиент прислал техническое задание» — то, что не
  // укладывается во встроенный список.
  customHandoffPrompt String?

  // ── Интеграция с Telegram ──
  // Один общий бот Smailee обслуживает все организации. Привязка создаётся
  // только через одноразовый deep-link; chat id пользователь не вводит.
  telegramChatId      String?   @unique
  telegramUsername    String?
  telegramConnectedAt DateTime?

  // ── Персональные уведомления о клиентских ответах ──
  customerNotificationScope CustomerNotificationScope @default(OWN)
  replyNotificationPolicy   ReplyNotificationPolicy   @default(ACTION_REQUIRED)
  telegramReplyMode         CustomerNotificationMode  @default(IMMEDIATE)
  telegramWarmLeadMode      CustomerNotificationMode  @default(IMMEDIATE)
  telegramGroupMinutes      Int                       @default(15)
  emailDigestReplies        Boolean                   @default(false)
  emailDigestWarmLeads      Boolean                   @default(false)
  emailDigestFrequency      CustomerDigestFrequency   @default(HOURLY)
  // Используется только для DAILY; час явно задан по Москве.
  emailDigestHourMsk        Int                       @default(10)

  mailboxes                      Mailbox[]
  domainGroups                   DomainGroup[]
  contacts                       Contact[]
  campaigns                      Campaign[]
  leads                          Lead[]                         @relation("UserLeads")
  templates                      EmailTemplate[]
  suppressions                   Suppression[]
  payments                       Payment[]
  billingSubscriptions           BillingSubscription[]
  setupRequests                  SetupRequest[]
  imageGenerations               ImageGeneration[]
  createdCampaigns               Campaign[]                     @relation("CampaignCreator")
  authTokens                     AuthToken[]
  credentialChange               AccountCredentialChange?
  emailChange                    AccountEmailChange?
  adminNotifications             AdminNotification[]
  adminTelegramInvites           AdminTelegramRecipient[]       @relation("AdminTelegramInviter")
  planNotifications              PlanNotification[]
  websiteCrawlsCreated           WebsiteCrawl[]                 @relation("WebsiteCrawlCreator")
  customerNotificationDeliveries CustomerNotificationDelivery[]
  prospectingRunsCreated         ProspectingRun[]               @relation("ProspectingRunCreator")

  @@index([scheduledPlanAt])
}

/**
 * Сгенерированная через fal.ai картинка для письма. Хранится не ради галереи,
 * а ради ЛИМИТА: 10 генераций в сутки на клиента (внешний платный API).
 * Счёт ведётся по строкам за последние 24 часа — отдельный счётчик с датой
 * сбрасывать не нужно, а история заодно позволяет переиспользовать картинку.
 */
model ImageGeneration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  url       String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum UserRole {
  CLIENT
  ADMIN
}

/// Права внутри одного кабинета компании.
/// ORG_ADMIN управляет организацией; остальные роли не имеют доступа к её
/// настройкам, тарифу, CRM и инфраструктуре.
enum OrganizationRole {
  ORG_ADMIN
  MEMBER
}

/// Точечные доступы сотрудника. Администратор организации всегда имеет их все.
enum OrganizationPermission {
  CONTACTS_VIEW
  CONTACTS_MANAGE
  CAMPAIGNS_VIEW_ALL
  CAMPAIGNS_CREATE
  CAMPAIGNS_MANAGE_OWN
  CAMPAIGNS_MANAGE_ALL
  CAMPAIGN_RECIPIENTS_VIEW
  STATS_VIEW_ALL
  LEADS_VIEW_ALL
  LEADS_REPLY_OWN
  LEADS_REPLY_ALL
  INFRASTRUCTURE_MANAGE
  BILLING_MANAGE
}

/// Какие кампании сотрудник хочет видеть в персональных уведомлениях.
/// ALL никогда не расширяет права: при доставке дополнительно проверяется
/// LEADS_REPLY_ALL, поэтому настройкой нельзя обойти ролевую модель.
enum CustomerNotificationScope {
  OWN
  ALL
}

enum CustomerNotificationMode {
  OFF
  IMMEDIATE
  GROUPED
}

enum ReplyNotificationPolicy {
  ACTION_REQUIRED
  ALL
}

enum CustomerDigestFrequency {
  EVERY_15_MINUTES
  HOURLY
  DAILY
}

enum CustomerNotificationCategory {
  REPLY
  WARM_LEAD
}

enum CustomerNotificationChannel {
  TELEGRAM
  EMAIL
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members         User[]               @relation("OrganizationMembers")
  businessProfile OrganizationProfile?
  demoWorkspace   DemoWorkspace?
  websiteCrawls   WebsiteCrawl[]
  prospectingRuns ProspectingRun[]

  @@index([ownerId])
}

enum DemoWorkspaceStatus {
  PENDING
  GENERATING
  ACTIVE
  DISABLED
  FAILED
}

/// Изолированная продуктовая песочница организации. Она не использует Mailbox
/// и поэтому принципиально не может попасть в SMTP/IMAP-движки.
model DemoWorkspace {
  id             String              @id @default(cuid())
  organizationId String              @unique
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         DemoWorkspaceStatus @default(PENDING)
  websiteUrl     String?
  scenario       Json?
  initializedAt  DateTime?
  disabledAt     DateTime?
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt

  mailboxes DemoMailbox[]

  @@index([status])
}

/// Виртуальный флот демо. Здесь намеренно нет SMTP/IMAP-реквизитов и связей
/// с Message: адреса используются только для визуальной эмуляции продукта.
model DemoMailbox {
  id              String        @id @default(cuid())
  demoWorkspaceId String
  demoWorkspace   DemoWorkspace @relation(fields: [demoWorkspaceId], references: [id], onDelete: Cascade)
  email           String
  senderName      String
  domain          String
  warmupDay       Int           @default(14)
  healthScore     Int           @default(100)
  coldSentToday   Int           @default(0)
  dailyLimit      Int           @default(30)
  createdAt       DateTime      @default(now())

  @@unique([demoWorkspaceId, email])
  @@index([demoWorkspaceId])
}

/// Единый подтверждённый контекст организации для генерации писем и ответов.
/// Черновик не влияет на боевой ИИ до явной публикации администратором.
model OrganizationProfile {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Подтверждённые администратором исходные данные. Они дополняют сайт при
  /// синтезе, но не содержат выводы предыдущего автоматического анализа.
  manualData             Json?
  draftData              Json?
  publishedData          Json?
  publishedAt            DateTime?
  staleAt                DateTime?
  sourceCrawlId          String?
  publishedSourceCrawlId String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt

  questions ProfileQuestion[]
  snapshots OrganizationProfileSnapshot[]

  @@index([staleAt])
}

/// Неизменяемая история публикаций профиля.
model OrganizationProfileSnapshot {
  id          String              @id @default(cuid())
  profileId   String
  profile     OrganizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  version     Int
  data        Json
  createdById String?
  createdAt   DateTime            @default(now())

  @@unique([profileId, version])
  @@index([profileId, createdAt])
}

enum WebsiteCrawlStatus {
  PENDING
  CRAWLING
  ANALYZING
  READY_FOR_REVIEW
  FAILED
  CANCELED
}

enum WebsitePageAnalysisStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Долговечное задание обхода сайта. Внешний job можно восстановить polling-ом
/// после рестарта приложения, даже если webhook не дошёл.
model WebsiteCrawl {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User               @relation("WebsiteCrawlCreator", fields: [createdById], references: [id], onDelete: Cascade)
  provider         String             @default("firecrawl")
  providerJobId    String?            @unique
  rootUrl          String
  status           WebsiteCrawlStatus @default(PENDING)
  pageLimit        Int                @default(50)
  maxDepth         Int                @default(3)
  includePaths     String[]           @default([])
  excludePaths     String[]           @default([])
  allowSubdomains  Boolean            @default(false)
  discoveredCount  Int                @default(0)
  crawledCount     Int                @default(0)
  analyzedCount    Int                @default(0)
  failedCount      Int                @default(0)
  creditsUsed      Int?
  error            String?
  /// Неизменяемый результат финальной сборки ИИ для этого обхода. Хранится
  /// отдельно от текущего черновика, чтобы версию можно было восстановить.
  profileData      Json?
  profileQuestions Json?
  profileVersion   Int?
  synthesizedAt    DateTime?
  attempts         Int                @default(0)
  nextPollAt       DateTime           @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt

  pages         WebsitePage[]
  webhookEvents WebsiteCrawlWebhookEvent[]

  @@unique([organizationId, profileVersion])
  @@index([organizationId, createdAt])
  @@index([status, nextPollAt])
}

model WebsitePage {
  id             String                    @id @default(cuid())
  crawlId        String
  crawl          WebsiteCrawl              @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url            String
  canonicalUrl   String
  title          String?
  description    String?
  contentType    String?
  statusCode     Int?
  markdown       String
  contentHash    String
  analysis       Json?
  analysisStatus WebsitePageAnalysisStatus @default(PENDING)
  attempts       Int                       @default(0)
  nextAttemptAt  DateTime                  @default(now())
  error          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @default(now()) @updatedAt

  @@unique([crawlId, canonicalUrl])
  @@index([crawlId, analysisStatus, nextAttemptAt])
}

model WebsiteCrawlWebhookEvent {
  id         String       @id
  crawlId    String
  crawl      WebsiteCrawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  type       String
  receivedAt DateTime     @default(now())

  @@index([crawlId, receivedAt])
}

enum ProfileQuestionStatus {
  OPEN
  ANSWERED
  DISMISSED
}

model ProfileQuestion {
  id        String                @id @default(cuid())
  profileId String
  profile   OrganizationProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category  String
  question  String
  reason    String?
  critical  Boolean               @default(false)
  status    ProfileQuestionStatus @default(OPEN)
  answer    String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @default(now()) @updatedAt

  @@index([profileId, status])
}

/// Одноразовые ссылки для приглашения сотрудника и восстановления пароля.
/// В БД хранится только SHA-256 хеш секрета из ссылки.
model AuthToken {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          AuthTokenType
  tokenHash     String        @unique
  expiresAt     DateTime
  usedAt        DateTime?
  verifiesEmail Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([userId, type, expiresAt])
}

/// Ожидающая подтверждения установка или смена пароля. Новые реквизиты
/// применяются только после перехода по ссылке из подтверждённой почты.
model AccountCredentialChange {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newPasswordHash String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}

/// Новая почта применяется только после перехода по ссылке, отправленной
/// именно на новый адрес.
model AccountEmailChange {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum AuthTokenType {
  INVITE
  INITIAL_ACCESS
  EMAIL_LOGIN
  EMAIL_CHANGE
  CREDENTIAL_CHANGE
  PASSWORD_RESET
  TELEGRAM_CONNECT
  ADMIN_TELEGRAM_CONNECT
}

enum Plan {
  TRIAL
  BASIC
  START
  PRO
}

// ── Платёж ──
model Payment {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // tochka | manual | ...
  externalId        String? // id операции в платёжном шлюзе
  amount            Int // в копейках
  plan              Plan // какой план оплачен
  status            PaymentStatus        @default(PENDING)
  kind              PaymentKind          @default(ONE_TIME)
  changeType        PlanChangeType       @default(ACTIVATE)
  // null остаётся только у исторических операций, созданных до появления
  // явного выбора момента активации.
  activationMode    PlanActivationMode?
  previousPlan      Plan?
  // Для NEXT_PERIOD фиксирует дату, после которой должен начаться уже
  // оплаченный новый период.
  entitlementEndsAt DateTime?
  subscriptionId    String?
  subscription      BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentLink       String?
  failureCode       String?
  failedAt          DateTime?
  expiresAt         DateTime?
  expiredAt         DateTime?
  // Редакция публичной оферты, показанная при создании этого платежа.
  offerVersion      String?
  createdAt         DateTime             @default(now())
  confirmedAt       DateTime?

  @@index([userId])
  @@index([userId, status, expiresAt])
  @@index([externalId])
  @@index([subscriptionId, status])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum PlanChangeType {
  ACTIVATE
  RENEW
  UPGRADE
  DOWNGRADE
}

enum PlanActivationMode {
  IMMEDIATE
  NEXT_PERIOD
}

enum PlanSource {
  TRIAL
  ADMIN
  PAYMENT
}

enum PaymentKind {
  ONE_TIME
  SUBSCRIPTION_INITIAL
  SUBSCRIPTION_RENEWAL
  MANUAL
}

enum BillingSubscriptionStatus {
  PENDING
  ACTIVE
  CHARGING
  PAST_DUE
  CANCELLED
  FAILED
}

/// Согласие на автопродление и состояние подписки в платёжном шлюзе.
/// Первый период подтверждается обычным webhook, следующие инициирует worker.
model BillingSubscription {
  id                     String                    @id @default(cuid())
  userId                 String
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               String                    @default("tochka")
  providerSubscriptionId String?                   @unique
  plan                   Plan
  amount                 Int
  status                 BillingSubscriptionStatus @default(PENDING)
  consentAt              DateTime
  offerVersion           String?
  activatedAt            DateTime?
  nextChargeAt           DateTime?
  chargeStartedAt        DateTime?
  cancelledAt            DateTime?
  providerCancelledAt    DateTime?
  lastFailureCode        String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  payments               Payment[]

  @@index([userId, status])
  @@index([status, nextChargeAt])
}

/// Этапы сервисной цепочки вокруг завершения демо или платного тарифа.
enum PlanNotificationKind {
  DEMO_ENDS_3D
  DEMO_ENDS_1D
  PLAN_DISABLED
  RETURN_3D
  RETURN_10D
  RETURN_30D
}

/// Надёжная очередь тарифных уведомлений. Цикл привязан к конкретной дате
/// окончания: продление или покупка отменяет старые строки и создаёт новые.
model PlanNotification {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                PlanNotificationKind
  cycleKey            String
  plan                Plan
  wasDemo             Boolean              @default(false)
  planEndsAt          DateTime
  requiresExpiryMatch Boolean              @default(true)
  scheduledAt         DateTime
  validUntil          DateTime?
  attempts            Int                  @default(0)
  nextAttemptAt       DateTime
  sentAt              DateTime?
  canceledAt          DateTime?
  lastError           String?
  createdAt           DateTime             @default(now())

  @@unique([userId, cycleKey, kind])
  @@index([sentAt, canceledAt, nextAttemptAt])
  @@index([userId, planEndsAt])
}

// ── Ящик (Mailbox) — единица отправки/приёма: логин@домен с IMAP+SMTP ──
// Провайдер-агностичен: provider — только подсказка для UI, логика ветвится по
// профилю host/port/security (см. src/lib/mail/profiles.ts), не по этому полю.
model Mailbox {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  senderName String // отображаемое имя отправителя (Sender Name)
  provider   MailProvider @default(yandex)

  // SMTP / IMAP доступы (host/port/security подставляются из профиля провайдера)
  smtpHost        String
  smtpPort        Int
  smtpSecurity    MailSecurity @default(SSL)
  smtpLogin       String
  imapHost        String
  imapPort        Int
  imapSecurity    MailSecurity @default(SSL)
  imapLogin       String
  // Пароли SMTP/IMAP — только зашифрованные (AES-256-GCM, src/lib/crypto.ts).
  // В открытом виде в БД не храним (ТЗ §8.2).
  smtpPasswordEnc String
  imapPasswordEnc String

  domainGroupId String
  domainGroup   DomainGroup @relation(fields: [domainGroupId], references: [id], onDelete: Cascade)

  // счётчик ХОЛОДНОЙ отправки (лимит 30/день на ящик, ТЗ §1.4)
  coldDailyLimit Int       @default(30)
  coldSentToday  Int       @default(0)
  coldSentDate   DateTime?

  // ОТДЕЛЬНЫЙ счётчик ПРОГРЕВА (в лимит 30 не входит, ТЗ §5.6).
  warmupSentToday Int         @default(0)
  warmupSentDate  DateTime?
  warmupDay       Int         @default(0) // текущая ступень ramp
  warmupState     WarmupState @default(off)
  warmupStartedAt DateTime?
  // Наш посевной ящик (ТЗ §5.6, §9.1) — заводится оператором вне кода, но
  // помечается этим флагом, чтобы движок прогрева всегда включал его в пиринг
  // независимо от userId (кросс-клиентская сеть) и без 14-дневного ramp-гейта.
  isSeed          Boolean     @default(false)
  // Имя папки "Спам" на IMAP-сервере — резолвится из профиля провайдера
  // (см. src/lib/mail/profiles.ts), как host/port, чтобы движок прогрева не
  // ветвился по provider при спасении писем из спама (§5.6).
  spamFolder      String      @default("Спам")

  connState            MailboxConnState  @default(paused) // ok | auth_error | unreachable | paused | disabled
  connError            String? // причина ошибки подключения (для подсветки в UI)
  // Скоринг здоровья (§5.8, M5) — пересчитывается computeFleetHealth (worker
  // tick) из реальных сигналов M1–M4 (доля FAILED-отправок, connState).
  // Только для отображения на дашборде — саму ротацию исключает connState.
  healthScore          Int               @default(100)
  // Причина авто- или ручной паузы (connState=disabled) — человекочитаемо,
  // для дашборда флота (§5.8). Null, если ящик не приостановлен по здоровью.
  pausedReason         String?
  // Машиночитаемая причина паузы: только NETWORK восстанавливается автоматически.
  pauseKind            MailboxPauseKind?
  connectionIncidentAt DateTime?
  reconnectAttempts    Int               @default(0)
  nextReconnectAt      DateTime?
  lastCheckedAt        DateTime?
  lastValidatedAt      DateTime?
  createdAt            DateTime          @default(now())

  // ── Позиция IMAP-поллинга (ТЗ §5.4, M3) ──
  // UIDVALIDITY эпохи INBOX + последний обработанный UID в ней. Нужны для
  // инкрементального опроса (не перечитывать весь ящик каждый тик) и чтобы не
  // поднимать старую переписку как "новые ответы" при первом подключении
  // (baseline на текущий UIDNEXT при первом опросе).
  imapUidValidity Int?
  imapLastUid     Int  @default(0)

  messages       Message[]
  warmupSent     WarmupEvent[] @relation("WarmupSender")
  warmupReceived WarmupEvent[] @relation("WarmupRecipient")

  @@unique([userId, email])
  @@index([domainGroupId])
  @@index([connState, pauseKind, nextReconnectAt])
}

// ── Домен-группа: все ящики на одном домене; на неё лимит 120/день (ТЗ §4.2) ──
model DomainGroup {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain        String
  dailyLimit    Int       @default(120) // лимит холодных на домен в день (ТЗ §1.4)
  sentToday     Int       @default(0)
  sentTodayDate DateTime?
  createdAt     DateTime  @default(now())

  mailboxes Mailbox[]

  @@unique([userId, domain])
}

// ── Событие сети прогрева (ТЗ §4.4, §5.6): одно письмо между двумя ящиками
// пула (нашими или чужими прогреваемыми/посевными). НЕ связано с Campaign/
// Message клиента — служебный трафик, в реальный инбокс не попадает.
model WarmupEvent {
  id                 String  @id @default(cuid())
  senderMailboxId    String
  senderMailbox      Mailbox @relation("WarmupSender", fields: [senderMailboxId], references: [id], onDelete: Cascade)
  recipientMailboxId String
  recipientMailbox   Mailbox @relation("WarmupRecipient", fields: [recipientMailboxId], references: [id], onDelete: Cascade)

  // Скрытый маркер (§5.6) — НЕ заголовок, зашит в тело письма (невидимый
  // span). По нему детектор (warmupDetector.ts) отличает прогрев от реального
  // ответа лида при IMAP-поллинге (inboundEngine.ts, M3-хук).
  code    String @unique
  subject String

  status WarmupEventStatus @default(sent)

  messageIdHeader String? // Message-ID отправленного письма (для тредов/ответов)
  recipientUid    Int? // UID письма у получателя (найден при поллинге) — чтобы
  // проход вовлечённости (read/reply/flag) бил по IMAP
  // напрямую, без повторного поиска
  // если это письмо — ответ в рамках прогревочного треда, code родительского события
  repliedToCode   String?
  // id узла корпуса (§5.9.3), которым сгенерировано это письмо — нужен, чтобы
  // при ответе выбрать дочерний узел (opener->response->continuation)
  corpusNodeId    String?
  // глубина треда: 0 = opener, 1 = response, 2 = continuation (ограничивает
  // многоходовость — движок вовлечённости не отвечает глубже §5.6)
  hop             Int     @default(0)

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  seenAt      DateTime?
  respondedAt DateTime?
  rescuedAt   DateTime?

  @@index([senderMailboxId])
  @@index([recipientMailboxId])
  @@index([status])
}

enum WarmupEventStatus {
  sent
  delivered
  opened
  replied
  rescued_from_spam
  failed
}

enum MailProvider {
  yandex
  google
  other
  custom
}

enum MailSecurity {
  SSL
  STARTTLS
}

enum WarmupState {
  off
  warming
  warm
}

enum MailboxConnState {
  ok
  auth_error
  unreachable
  paused
  // Авто- или вручную приостановлен мониторингом здоровья флота (§5.8, M5).
  // НЕ входит ни в один allow-list ("ok"/"paused") движков M2–M4 — ящик
  // выпадает из отправки/приёма/прогрева без единой правки их кода.
  // Отличается от "paused" (= только что подключён, ждёт первого успеха):
  // тот остаётся в ротации, чтобы иметь шанс подтвердить логин.
  disabled
}

enum MailboxPauseKind {
  MANUAL
  AUTH
  NETWORK
  DELIVERY_FAILURES
}

// ── Контакт из базы клиента ──
model Contact {
  id                        String                 @id @default(cuid())
  userId                    String
  user                      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                     String
  name                      String?
  company                   String?
  /// null = use website-confirmed company name, empty = explicitly suppress it.
  communicationNameOverride String?
  segment                   String? // сегмент/ниша
  meta                      Json?
  customFields              Json?
  source                    String                 @default("USER_UPLOAD")
  sourceCompanyId           String?
  sourceCompany             Company?               @relation("ContactSourceCompany", fields: [sourceCompanyId], references: [id], onDelete: SetNull)
  role                      String?
  domain                    String?
  website                   String?
  status                    ContactStatus          @default(ACTIVE)
  // результат валидации email при загрузке
  emailValid                Boolean                @default(true)
  verificationState         EmailVerificationState @default(UNVERIFIED)
  verificationStatus        String?
  verificationScore         Int?
  verificationSource        String?
  lastValidatedAt           DateTime?
  relevanceStatus           ContactRelevanceStatus @default(RELEVANT)
  irrelevanceReason         String?
  isDemo                    Boolean                @default(false)
  isControl                 Boolean                @default(false)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @default(now()) @updatedAt

  messages Message[]

  @@unique([userId, email])
  @@index([userId, segment])
  @@index([userId, source])
  @@index([userId, verificationState])
  @@index([userId, relevanceStatus])
  @@index([sourceCompanyId])
}

enum ContactRelevanceStatus {
  RELEVANT
  IRRELEVANT
}

/// Immutable monthly processing ledger. Deleting a contact never restores
/// already spent processing quota and the operation key prevents double spend.
model ContactQuotaEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  operationKey   String   @unique
  email          String
  source         String
  contactId      String?
  runId          String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

/// Durable queue for large multi-sheet customer workbooks. The parsed payload
/// is bounded before insertion and lets the web request finish without waiting
/// for email/site providers.
model ContactImportJob {
  id                   String              @id @default(cuid())
  organizationId       String
  userId               String
  fileName             String
  status               ContactImportStatus @default(QUEUED)
  sourceRows           Int
  totalContacts        Int
  prevalidatedContacts Int                 @default(0)
  processedContacts    Int                 @default(0)
  invalidContacts      Int                 @default(0)
  siteAnalyzedContacts Int                 @default(0)
  issueCount           Int                 @default(0)
  summary              Json?
  errorCode            String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now()) @updatedAt

  items ContactImportItem[]

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}

model ContactImportItem {
  id        String                  @id @default(cuid())
  jobId     String
  job       ContactImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  email     String
  payload   Json
  status    ContactImportItemStatus @default(PENDING)
  claimId   String?
  errorCode String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @default(now()) @updatedAt

  @@unique([jobId, email])
  @@index([jobId, status])
}

/// Product feedback is retained even if the contact itself is later deleted.
/// Only company traits from snapshot may be used for future exclusion rules.
model ContactRelevanceFeedback {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  contactId       String?
  companyId       String?
  email           String
  reason          String?
  companySnapshot Json?
  createdAt       DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([companyId])
}

enum ContactStatus {
  ACTIVE
  BOUNCED
  UNSUBSCRIBED
  INVALID
  COMPLAINED
}

// ── Библиотека HTML-шаблонов писем ──
model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String? // null = системный (пресет), иначе — пользовательский
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String // announce | digest | promo | outreach | custom
  subject   String
  html      String // HTML-тело с переменными {{name}} и т.п.
  isPreset  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

// ── Кампания рассылки ──
model Campaign {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Кто запустил кампанию в рамках организации. Нужен для ограничений
  // менеджера кампаний и не заменяет userId владельца данных организации.
  createdById        String?
  createdBy          User?          @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name               String
  subject            String
  body               String // текст/HTML письма (основной вариант / вариант A)
  isHtml             Boolean        @default(false)
  // A/B: необязательный второй вариант
  subjectB           String?
  bodyB              String?
  abEnabled          Boolean        @default(false)
  segment            String?
  // Пачка кампаний, созданных одним прогоном мастера по нескольким сегментам:
  // на каждый сегмент — своя кампания (свой текст, своя статистика), но
  // запускаются и показываются вместе. null = обычная одиночная кампания.
  batchId            String?
  status             CampaignStatus @default(DRAFT)
  scheduledAt        DateTime? // отложенный запуск (send_at)
  // R4: «Запустить после прогрева» — вместо красной ошибки при непрогретых
  // ящиках кампания ждёт (status=SCHEDULED, scheduledAt=null), и воркер сам
  // стартует её, когда у клиента появится первый ящик warmupState=warm.
  launchAfterWarmup  Boolean        @default(false)
  // Отслеживание открытий и кликов. ВЫКЛЮЧЕНО по умолчанию осознанно: пиксель
  // и подменённые ссылки снижают доставляемость, а на аналитику влияют слабо
  // (открытия завышают почтовые прокси). Практика рынка — включать только на
  // время теста, боевую рассылку гонять без трекинга.
  //
  // Механика: пиксель и подмена ссылок работают лишь в HTML, поэтому при
  // включённом трекинге текстовое письмо уходит как multipart/alternative —
  // чистый текст плюс HTML-двойник. Выключено — уходит чистый text/plain.
  trackingEnabled    Boolean        @default(false)
  // Follow-up (§«Составлена ли цепочка»): настраиваемая
  // цепочка писем, если нет ответа. followupDays/Subject/Body ниже —
  // ПРЕЖНЯЯ одноская схема, оставлена только для кампаний, созданных до
  // введения FollowupStep (новый код её не пишет и не читает; колонки не
  // удалены — миграции прода только аддитивные).
  followupEnabled    Boolean        @default(false)
  followupDays       Int            @default(3)
  followupSubject    String?
  followupBody       String?
  followupSteps      FollowupStep[]
  createdAt          DateTime       @default(now())
  startedAt          DateTime?
  archivedAt         DateTime?
  // Демо-кампания хранит только 5–7 персонализированных примеров. Полный
  // объём и агрегаты лежат отдельно и никогда не материализуются в очередь.
  isDemo             Boolean        @default(false)
  demoAudienceSize   Int?
  demoGeneratedCount Int?
  demoStats          Json?

  // NB: кампания раскидывается по ПУЛУ ящиков (ТЗ §5.3), поэтому единого
  // отправителя у неё нет — ящик назначается на каждое Message при отправке (M2).

  messages Message[]

  @@index([userId, batchId])
  @@index([createdById])
  @@index([isDemo, status])
}

// ── Шаг цепочки follow-up (цепочка из 3-4 писем,
// каждое со своим интервалом от предыдущего) ──
// stepNumber соответствует Message.step письма, которое этот шаг порождает:
// шаг 1 создаётся из письма step=0 (исходного), шаг 2 — из письма step=1,
// и так далее. daysAfterPrevious считается от sentAt ПРЕДЫДУЩЕГО шага, не от
// исходного письма — так каждый интервал в цепочке независим от остальных.
model FollowupStep {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepNumber        Int
  daysAfterPrevious Int
  subject           String
  body              String

  @@unique([campaignId, stepNumber])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  SENT
  PAUSED
}

// ── Каждое отправленное письмо = отдельная запись со статусом ──
model Message {
  id                           String                       @id @default(cuid())
  campaignId                   String
  campaign                     Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId                    String
  contact                      Contact                      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  subject                      String
  body                         String
  isHtml                       Boolean                      @default(false)
  variant                      String                       @default("A") // A | B (для A/B)
  step                         Int                          @default(0) // 0 = основное, 1+ = follow-up
  status                       MessageStatus                @default(PENDING)
  // Финальный текст холодного письма готовится отдельно для каждого контакта.
  // SMTP-движок имеет право забирать только READY; общий шаблон кампании
  // никогда не используется как молчаливый fallback.
  personalizationStatus        MessagePersonalizationStatus @default(PENDING)
  personalizationAttempts      Int                          @default(0)
  personalizationError         String?
  personalizationContextHash   String?
  personalizationMeta          Json?
  personalizationClaimedAt     DateTime?
  personalizationNextAttemptAt DateTime?
  personalizedAt               DateTime?
  providerMessageId            String?
  sentAt                       DateTime?
  deliveredAt                  DateTime?
  openedAt                     DateTime?
  clickedAt                    DateTime?
  repliedAt                    DateTime?
  followupSentAt               DateTime? // когда отправлен follow-up для этого письма
  error                        String?
  createdAt                    DateTime                     @default(now())

  // Настройки и состояние диалога Inbox. Message — корневая сущность
  // переписки с конкретным контактом в рамках кампании.
  aiRepliesEnabled     Boolean   @default(true)
  refusalSuggestedAt   DateTime?
  refusedAt            DateTime?
  nextContactAt        DateTime?
  // null = наследовать глобальную настройку User.autoPingEnabled.
  autoPingEnabled      Boolean?
  autoPingIntervalDays Int?
  autoPingMaxAttempts  Int?
  autoPingAttempts     Int       @default(0)
  autoPingNextAt       DateTime?
  autoPingLastSentAt   DateTime?
  autoPingStoppedAt    DateTime?

  // ── Модель C: через какой ящик отправлено (для непрерывности треда и лимитов) ──
  // Назначается движком отправки M2; в M1 остаётся null.
  mailboxId String?
  mailbox   Mailbox? @relation(fields: [mailboxId], references: [id])

  // Поля связывания входящего ответа с исходящим (фундамент диалога, IMAP M3):
  messageIdHeader String? // Message-ID отправленного письма
  inReplyTo       String? // In-Reply-To входящего
  threadRefs      String? // References (цепочка Message-ID)
  threadAddress   String? // адрес треда (reply+<id>@…) — если используется

  events Event[]
  thread ReplyMessage[]
  lead   Lead?

  @@index([campaignId, status])
  @@index([campaignId, personalizationStatus, status])
  @@index([mailboxId])
  @@index([autoPingNextAt])
  @@index([refusedAt, refusalSuggestedAt])
}

enum MessagePersonalizationStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
}

// ── Сырые события (open/click/bounce/reply) для аналитики ──
model Event {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      String // open | click | bounce | reply | delivered | complaint
  payload   Json?
  createdAt DateTime @default(now())

  @@index([messageId, type])
}

// ── Диалог: входящие ответы + AI-ответы (email-тред) ──
model ReplyMessage {
  id          String           @id @default(cuid())
  messageId   String
  message     Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  direction   String // inbound (от клиента) | outbound (AI-ответ)
  subject     String? // тема письма (Re: ...)
  fromEmail   String?
  toEmail     String?
  body        String
  isAi        Boolean          @default(false)
  kind        ReplyMessageKind @default(REPLY)
  // Для запланированного автопинга: точный момент, когда воркер сможет
  // отправить сохранённый и при необходимости отредактированный текст.
  scheduledAt DateTime?
  createdAt   DateTime         @default(now())

  // Режим модерации (ТЗ §5.5): outbound AI-ответ создаётся со статусом DRAFT,
  // если у клиента включена модерация — реально не отправлен, ждёт оператора
  // (approveAndSendReply). SENT — либо отправлено сразу (модерация выключена),
  // либо после одобрения. Для inbound всегда SENT (это не наша отправка).
  status            ReplyMessageStatus @default(SENT)
  // Message-ID входящего письма (для идемпотентности при повторном поллинге
  // и как материал для In-Reply-To будущих ответов в этом треде).
  externalMessageId String?
  // Message-ID реально отправленного AI-ответа (от sendViaMailbox), по
  // аналогии с Message.providerMessageId.
  providerMessageId String?

  notificationDeliveries CustomerNotificationDelivery[]

  @@index([messageId])
  @@index([externalMessageId])
  @@index([kind, status, scheduledAt])
}

/// Надёжная очередь персональных уведомлений. Категория намеренно не входит
/// в unique: один входящий ответ может стать либо REPLY, либо WARM_LEAD, но
/// никогда не должен продублироваться в обеих группах одного канала.
model CustomerNotificationDelivery {
  id            String                       @id @default(cuid())
  recipientId   String
  recipient     User                         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  sourceReplyId String
  sourceReply   ReplyMessage                 @relation(fields: [sourceReplyId], references: [id], onDelete: Cascade)
  category      CustomerNotificationCategory
  channel       CustomerNotificationChannel
  deliverAfter  DateTime
  nextAttemptAt DateTime                     @default(now())
  attempts      Int                          @default(0)
  lockedUntil   DateTime?
  sentAt        DateTime?
  canceledAt    DateTime?
  lastError     String?
  createdAt     DateTime                     @default(now())

  @@unique([recipientId, sourceReplyId, channel])
  @@index([channel, sentAt, canceledAt, deliverAfter, nextAttemptAt])
  @@index([recipientId, category, sentAt])
}

enum ReplyMessageKind {
  REPLY
  AUTO_PING
}

enum ReplyMessageStatus {
  DRAFT
  SENT
}

// ── Квалифицированный лид ──
model Lead {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation("UserLeads", fields: [userId], references: [id], onDelete: Cascade)
  messageId      String            @unique
  message        Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  qualification  LeadQualification @default(UNKNOWN)
  summary        String?
  pushedToCrm    Boolean           @default(false)
  // id лида, созданного на стороне Битрикса. Раньше API его возвращал, но
  // никуда не писался — связь с CRM терялась, и понять «а этот лид уже там,
  // под каким номером?» было нельзя ни из интерфейса, ни из поддержки.
  crmEntityId    String?
  // Момент передачи в CRM = «линия закрыта» с нашей стороны. С этого момента
  // ИИ ПЕРЕСТАЁТ отвечать на входящие по этому письму: дальше с клиентом
  // работает живой продавец в CRM, и два автора в одной переписке наперегонки
  // — худшее, что можно сделать с тёплым лидом.
  handedOffAt    DateTime?
  // Какой из настроенных триггеров сработал (ключ из handoffTriggers.ts) —
  // видно в интерфейсе и нужно, чтобы понимать, какие триггеры реально
  // работают, а какие никогда не срабатывают.
  handoffTrigger String?
  // Ручная отметка оператора. Автоматические процессы это поле не заполняют.
  processedAt    DateTime?
  createdAt      DateTime          @default(now())

  @@index([userId, qualification])
  @@index([userId, processedAt])
}

enum LeadQualification {
  HOT
  COLD
  IRRELEVANT
  UNKNOWN
}

// ── Suppression-список: отписки, отказы в переписке, жалобы, невалидные ──
// (не слать). Общий на аккаунт, не на кампанию — отказ есть отказ навсегда,
// а не "не пишите в ЭТОЙ рассылке".
model Suppression {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  reason     String // unsubscribed | declined_via_reply | complained | bounced | manual
  createdAt  DateTime  @default(now())
  // Оператор вручную вернул контакт в рассылку (напр. "отказался полгода
  // назад, вдруг актуально сейчас"). NULL = запись активна и блокирует
  // отправку; заполнено = историческая запись, контакт снова доступен.
  // Мягкое удаление, не DELETE — история отказов не теряется.
  releasedAt DateTime?

  @@unique([userId, email])
  @@index([userId])
}

// ── Заявка «Настройте всё за меня» (онбординг-визард, R2) ──
// Пока уходит письмом оператору (config.setupNotifyEmail) + видна в админке;
// позже — интеграция с CRM.
model SetupRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  contact       String // телефон / telegram / email — как удобно клиенту
  preferredTime String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

// ── Заявка с лендинга (лид-форма / запись на демо) ──
model LandingLead {
  id                    String    @id @default(cuid())
  name                  String
  email                 String
  messenger             String?
  company               String?
  website               String?
  source                String? // utm/канал
  privacyConsentAt      DateTime?
  privacyConsentVersion String?
  createdAt             DateTime  @default(now())
}

/// Текущее состояние внешних API, общих для всех организаций.
model SystemApiIncident {
  id            String    @id @default(cuid())
  service       String    @unique
  message       String
  failureCount  Int       @default(1)
  firstFailedAt DateTime  @default(now())
  lastFailedAt  DateTime  @default(now())
  resolvedAt    DateTime?
}

/// Надёжная очередь важных писем администраторам организации.
/// Событие сначала сохраняется в PostgreSQL, поэтому не теряется при рестарте воркера
/// или временной недоступности системного SMTP.
model AdminNotification {
  id              String    @id @default(cuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  dedupeKey       String    @unique
  recipientEmails String[]
  subject         String
  text            String
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  sentAt          DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())

  @@index([sentAt, nextAttemptAt])
  @@index([userId, createdAt])
}

/// Получатели закрытого служебного Telegram-бота. Доступ выдаёт только ADMIN
/// одноразовой ссылкой из админки; отзыв мягкий, чтобы сохранить аудит.
model AdminTelegramRecipient {
  id               String                  @id @default(cuid())
  chatId           String                  @unique
  telegramUsername String?
  telegramName     String?
  invitedById      String?
  invitedBy        User?                   @relation("AdminTelegramInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  connectedAt      DateTime                @default(now())
  revokedAt        DateTime?
  deliveries       AdminTelegramDelivery[]

  @@index([revokedAt, connectedAt])
}

/// Надёжная очередь системных сообщений в закрытый Telegram-бот.
/// Событие сохраняется отдельно для каждого активного получателя и повторяется воркером при временном сбое API.
model AdminTelegramDelivery {
  id            String                 @id @default(cuid())
  recipientId   String
  recipient     AdminTelegramRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type          String
  text          String
  buttonText    String?
  buttonUrl     String?
  attempts      Int                    @default(0)
  nextAttemptAt DateTime               @default(now())
  sentAt        DateTime?
  discardedAt   DateTime?
  lastError     String?
  createdAt     DateTime               @default(now())

  @@index([sentAt, discardedAt, nextAttemptAt])
  @@index([recipientId, createdAt])
}
